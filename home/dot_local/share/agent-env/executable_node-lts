#!/bin/bash
# Run Node LTS from mise directly, not through a shim. A shim would put every
# mise install directory on PATH for the agent and the commands it starts.
set -euo pipefail
mise_bin="$(command -v mise || true)"
[[ -n $mise_bin || ! -x $HOME/.local/bin/mise ]] || mise_bin="$HOME/.local/bin/mise"
if [[ -z $mise_bin ]]; then
  printf '%s\n' 'agent-env: mise is not installed or is not on PATH.' >&2
  exit 127
fi
if ! node_bin="$(MISE_OFFLINE=1 "$mise_bin" which --tool node@lts node 2>/dev/null)" || [[ ! -x $node_bin ]]; then
  printf '%s\n' 'agent-env: Node LTS is not installed. Run: mise install node@lts' >&2
  exit 127
fi
exec "$node_bin" "$@"
