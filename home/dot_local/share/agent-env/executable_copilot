#!/bin/bash
# Start Copilot CLI with the agent command environment. zsh aliases `copilot` here.
set -euo pipefail
dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mise_bin="$(command -v mise || true)"
[[ -n $mise_bin || ! -x $HOME/.local/bin/mise ]] || mise_bin="$HOME/.local/bin/mise"
if [[ -z $mise_bin ]]; then
  printf '%s\n' 'agent-env: mise is not installed or is not on PATH.' >&2
  exit 127
fi
if ! copilot_bin="$(MISE_OFFLINE=1 "$mise_bin" which --tool npm:@github/copilot copilot 2>/dev/null)" || [[ ! -x $copilot_bin ]]; then
  printf '%s\n' 'agent-env: Copilot CLI is not installed in mise.' >&2
  exit 127
fi
exec "$dir/node-lts" "$dir/copilot.mjs" "$copilot_bin" "$@"
