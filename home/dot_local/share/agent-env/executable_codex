#!/bin/bash
# Start Codex CLI with native per-invocation command environment settings.
set -euo pipefail
dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mise_bin="$(command -v mise || true)"
[[ -n $mise_bin || ! -x $HOME/.local/bin/mise ]] || mise_bin="$HOME/.local/bin/mise"
if [[ -z $mise_bin ]]; then
  printf '%s\n' 'agent-env: mise is not installed or is not on PATH.' >&2
  exit 127
fi
if ! codex_bin="$(MISE_OFFLINE=1 "$mise_bin" which --tool npm:@openai/codex codex 2>/dev/null)" || [[ ! -x $codex_bin ]]; then
  printf '%s\n' 'agent-env: Codex CLI is not installed in mise.' >&2
  exit 127
fi
exec "$dir/node-lts" "$dir/codex.mjs" "$codex_bin" "$@"
