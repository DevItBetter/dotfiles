#!/bin/bash
# Make zsh the login shell. Needs a terminal because chsh asks for a password.
set -euo pipefail
zsh_path="$(command -v zsh || true)"
[[ -n $zsh_path ]] || exit 0
{{- if eq .chezmoi.os "darwin" }}
current="$(dscl . -read "/Users/$(id -un)" UserShell | awk '{print $2}')"
{{- else }}
current="$(getent passwd "$(id -un)" | cut -d: -f7)"
{{- end }}
[[ ${current##*/} == zsh ]] && exit 0
if [[ ! -t 0 ]] || ! command -v chsh >/dev/null 2>&1; then
  printf 'Login shell is %s. To use zsh, run: chsh -s %s\n' "$current" "$zsh_path"
  exit 0
fi
if ! grep -Fxq "$zsh_path" /etc/shells; then
  printf '%s\n' "$zsh_path" | sudo tee -a /etc/shells >/dev/null
fi
chsh -s "$zsh_path" || printf 'chsh failed. Run it yourself: chsh -s %s\n' "$zsh_path"
