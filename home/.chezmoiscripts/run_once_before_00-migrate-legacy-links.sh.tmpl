#!/bin/bash
# Preserve local settings before retiring the old symlink setup.
set -euo pipefail
config="${XDG_CONFIG_HOME:-$HOME/.config}"
source_dir={{ .chezmoi.workingTree | quote }}
legacy=false
for path in "$HOME/.zshrc" "$HOME/.zshenv" "$HOME/.gitconfig" "$HOME/.tmux.conf" \
    "$HOME/.local/bin/tmux-pane-bg" "$HOME/.cursor/rules" \
    "$config/starship.toml" "$config/alacritty/alacritty.toml" \
    "$config/opencode/plugins/command-environment."{js,mjs} \
    "$HOME/.pi/agent/extensions/command-environment."{js,mjs} \
    "$config/mise/conf.d/00-dotfiles-settings.toml" "$config/mise/config.toml"; do
  [[ ! -L $path ]] || legacy=true
done
for path in "$HOME/.gitconfig.local" "$HOME/.zsh_plugins.zsh" \
    "$config/mise/dotfiles-selection.json" "$config/mise/config.toml" "$config"/mise/conf.d/10-dotfiles-*.toml \
    "$config/dotfiles/"{env,local}.zsh \
    "$HOME/dotfiles/zsh/config/"{work,local}.zsh \
    "$source_dir/zsh/config/"{work,local}.zsh; do
  [[ ! -e $path && ! -L $path ]] || legacy=true
done
[[ $legacy == true ]] || exit 0

python3 - <<'DOTFILES_MIGRATION'
{{ include ".chezmoitemplates/migrate-legacy.py" }}
migrate(
    Path.home(),
    Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))),
    Path({{ .chezmoi.workingTree | toJson }}),
    json.loads({{ .mise.tools | toJson | toJson }}),
    {{ includeTemplate "mise-tools" . | splitList "\n" | toJson }},
)
DOTFILES_MIGRATION
