# Managed by chezmoi. Machine-local settings, including `git config --global`
# writes, go in ~/.gitconfig, which Git reads after this file.
[user]
	name = {{ .name }}
	email = {{ .email }}

{{ if stat (joinPath .chezmoi.homeDir ".gitconfig.local") -}}
# Preserve overrides from the pre-chezmoi setup. ~/.gitconfig is read afterward.
[include]
    path = ~/.gitconfig.local
{{ end }}

[color]
    branch = auto
    diff = auto
    grep = auto
    interactive = auto
    pager = true
    showbranch = auto
    status = auto
    ui = auto
    
[alias]
	branches = branch -a
	tags = tag
	stashes = stash list
	unstage = reset -q HEAD --
	discard = checkout --
	uncommit = reset --mixed HEAD~
	amend = commit --amend
	
    log2 = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    log3 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
    
[push]
	default = simple
[pull]
	ff = only
[core]
	pager = diff-so-fancy | less --tabs=4 -RFX
