// Run OpenCode shell commands in Bash with the agent command environment.
import { commandEnvironment } from {{ joinPath .chezmoi.homeDir ".local/share/agent-env/command-environment.mjs" | toJson }};

export default {
  id: "command-environment",
  async setup(ctx) {
    await ctx.shell.hook("create.before", (event) => {
      Object.assign(event.env, commandEnvironment({ ...process.env, ...event.env }));
      event.shell = "/bin/bash";
    });
  },
};
