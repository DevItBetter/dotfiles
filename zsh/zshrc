[[ -o interactive ]] || return 0

if [[ -n ${TILIX_ID:-}${VTE_VERSION:-} && -r /etc/profile.d/vte.sh ]]; then
    source /etc/profile.d/vte.sh
fi

# Environment Settings
source "$HOME/dotfiles/zsh/config/exports.zsh"

[[ -e "$HOME/dotfiles/zsh/config/work.zsh" ]] && source "$HOME/dotfiles/zsh/config/work.zsh"
[[ -e "$HOME/dotfiles/zsh/config/local.zsh" ]] && source "$HOME/dotfiles/zsh/config/local.zsh"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
if [[ -x /usr/bin/conda ]] && __conda_setup="$(/usr/bin/conda shell.zsh hook 2>/dev/null)"; then
    eval "$__conda_setup"
else
    if [ -f "/usr/etc/profile.d/conda.sh" ]; then
        . "/usr/etc/profile.d/conda.sh"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# mise shims are added in ~/.zshenv so all zsh invocations can find them.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

source "$HOME/dotfiles/zsh/config/history.zsh"
source "$HOME/dotfiles/zsh/config/setopt.zsh"
source "$HOME/dotfiles/zsh/config/completions.zsh"
source "$HOME/dotfiles/zsh/config/bindkeys.zsh"
source "$HOME/dotfiles/zsh/config/fzf.zsh"
source "$HOME/dotfiles/zsh/config/aliases.zsh"

# Useful functions
source "$HOME/dotfiles/zsh/config/functions.zsh"

# WSL setup
if is_wsl; then
  _cfg="$HOME/dotfiles/zsh/config/windows/wsl2-ssh-agent.zsh"
  [[ -r "$_cfg" ]] && source "$_cfg"
  unset _cfg
fi

# -------------------------------------------------------------------
# Antidote Plugin Manager
# -------------------------------------------------------------------
if [[ -r "${ZDOTDIR:-$HOME}/.antidote/antidote.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.antidote/antidote.zsh"
fi
if [[ -r "${ZDOTDIR:-$HOME}/.zsh_plugins.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zsh_plugins.zsh"
fi

# -------------------------------------------------------------------
# Starship Prompt
# -------------------------------------------------------------------
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
