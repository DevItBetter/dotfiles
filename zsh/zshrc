[[ -o interactive ]] || return 0

# Also support sourcing this file directly from a relocated checkout.
export DOTFILES_DIR="${DOTFILES_DIR:-${${(%):-%x}:A:h:h}}"

if [[ -n ${TILIX_ID:-}${VTE_VERSION:-} && -r /etc/profile.d/vte.sh ]]; then
    source /etc/profile.d/vte.sh
fi

# Environment Settings
source "$DOTFILES_DIR/zsh/config/exports.zsh"

_dotfiles_local="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
[[ -r "$_dotfiles_local/env.zsh" ]] && source "$_dotfiles_local/env.zsh"

# mise shims are added in ~/.zshenv so all zsh invocations can find them.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# -------------------------------------------------------------------
# Antidote Plugin Manager
# -------------------------------------------------------------------
if [[ -r "${ZDOTDIR:-$HOME}/.antidote/antidote.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.antidote/antidote.zsh"
fi
if [[ -r "${ZDOTDIR:-$HOME}/.zsh_plugins.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zsh_plugins.zsh"
fi

source "$DOTFILES_DIR/zsh/config/history.zsh"
source "$DOTFILES_DIR/zsh/config/setopt.zsh"
source "$DOTFILES_DIR/zsh/config/completions.zsh"
source "$DOTFILES_DIR/zsh/config/bindkeys.zsh"
source "$DOTFILES_DIR/zsh/config/fzf.zsh"
source "$DOTFILES_DIR/zsh/config/aliases.zsh"
source "$DOTFILES_DIR/zsh/config/functions.zsh"

if is_wsl && [[ -x "$HOME/.local/bin/wsl2-ssh-agent" ]]; then
  source "$DOTFILES_DIR/zsh/config/windows/wsl2-ssh-agent.zsh"
fi

# -------------------------------------------------------------------
# Starship Prompt
# -------------------------------------------------------------------
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Preserve old checkout-local overrides during migration; prefer the XDG file.
[[ -r "$DOTFILES_DIR/zsh/config/work.zsh" ]] && source "$DOTFILES_DIR/zsh/config/work.zsh"
[[ -r "$DOTFILES_DIR/zsh/config/local.zsh" ]] && source "$DOTFILES_DIR/zsh/config/local.zsh"
[[ -r "$_dotfiles_local/local.zsh" ]] && source "$_dotfiles_local/local.zsh"
unset _dotfiles_local
